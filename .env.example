# Copier en .env pour le dev local.

# Identifiants Postgres — lus par docker-compose (services `db` et `web`).
# Si absents, docker-compose retombe sur les valeurs par défaut `tasks`.
# ⚠️ CHANGE `POSTGRES_PASSWORD` : ne laisse pas la valeur par défaut, même en
# local. Génère un secret : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_USER="tasks"
POSTGRES_PASSWORD="tasks"
POSTGRES_DB="tasks"

# App + Prisma CLI en dev local (host → localhost). Chaîne littérale : Prisma
# n'expanse pas les ${...} — garde-la alignée sur POSTGRES_* ci-dessus.
DATABASE_URL="postgresql://tasks:tasks@localhost:5432/tasks?schema=public"

# Serveur MCP : token d'accès requis pour l'endpoint /api/mcp. Génère un secret :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=""
