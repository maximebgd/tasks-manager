# Copier en .env pour le dev local. En Docker, la valeur est fournie par docker-compose.yml.
DATABASE_URL="postgresql://tasks:tasks@localhost:5432/tasks?schema=public"

# Serveur MCP : token d'accès requis pour l'endpoint /api/mcp. Génère un secret :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=""
